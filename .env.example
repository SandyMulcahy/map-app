# Copy this file to .env.local and fill in the two values from your Supabase project
# (Project Settings -> API Keys / Data API). Both are safe to expose in the browser:
# row-level security in supabase/schema.sql is what protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
